# ---------- Servidor ----------
PORT=3000
NODE_ENV=development
# Origen permitido por CORS (dirección del frontend de Vite)
FRONTEND_URL=http://localhost:5173

# ---------- Base de datos MariaDB ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=practifp
DB_PASSWORD=cambia_esta_contraseña
DB_NAME=practifp
DB_CONNECTION_LIMIT=10

# ---------- Autenticación ----------
# Genera un valor largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=8h

# ---------- Producción ----------
# true: el backend sirve también el frontend compilado (frontend/dist)
SERVIR_FRONTEND=false
# Número de proxies inversos delante del servidor (p. ej. 1 con Nginx); 0 si no hay
TRUST_PROXY=0
# Carpeta de archivos subidos (por defecto backend/uploads)
# UPLOADS_DIR=/var/lib/practifp/uploads
