# Configuración para inicializar la base de datos de TiDB Cloud desde tu ordenador
# (despliegue en Vercel). Copia este archivo como .env.tidb y rellénalo con los
# datos de "Connect" de tu clúster de TiDB Cloud.
# Uso (Linux/macOS):        DOTENV_CONFIG_PATH=.env.tidb npm run db:reset
# Uso (Windows PowerShell): $env:DOTENV_CONFIG_PATH=".env.tidb"; npm run db:reset

DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=XXXXXXXXXXXXXXX.root
DB_PASSWORD=la_contraseña_de_tidb
DB_NAME=practifp
DB_SSL=true
ALMACEN_ARCHIVOS=bd

# Necesario para que arranque la configuración (no se usa para inicializar)
JWT_SECRET=cualquier_valor_de_al_menos_32_caracteres_aqui
