# Copia este archivo como .env (en la carpeta raíz del proyecto) y rellénalo.
# Genera contraseñas y secretos aleatorios con:  openssl rand -hex 32

# Dominio de la web (por ejemplo, el gratuito de DuckDNS: practifp.duckdns.org)
DOMINIO=practifp.duckdns.org

# Contraseñas de MariaDB
DB_ROOT_PASSWORD=cambia_esto
DB_PASSWORD=cambia_esto_tambien

# Secreto para firmar las sesiones (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio

# Correo para "¿Has olvidado tu contraseña?" (opcional; sin él, esa opción avisa de que no está disponible)
# Ejemplo con Brevo (gratis): crea una clave en SMTP & API → SMTP y verifica el remitente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
